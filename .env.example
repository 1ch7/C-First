# EventPilot: no secrets are committed.
PORT=3000
HOST=127.0.0.1
EVENTPILOT_DB=data/eventpilot.sqlite
# Optional Google OAuth web client ID. This is an identifier, not a secret.
# Authorized JavaScript origin must match your deployed HTTPS app origin.
GOOGLE_CLIENT_ID=
# WorkBuddy keyless LLM activation (cloud service).
# These are public config values from workbuddy_cloud_service activate, not secrets.
# WB_CLOUD_ENDPOINT=https://xxx.workbuddy.link
# WB_CLOUD_PUBLISHABLE_KEY=wbapp_xxx
# WB_CLOUD_OAUTH_RELAY=https://xxx.workbuddy.link
# AI/ML API key for server-side LLM prompt interpretation (alternative to WorkBuddy keyless).
# This is a secret — keep it in the hosting environment, never in source control or client-side code.
# AIML_API_KEY=your-aiml-api-key-here
# No Gmail tokens are stored. gmail.compose only; draft creation, never sending.
